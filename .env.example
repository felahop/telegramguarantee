# ── Runtime ──────────────────────────────────────────────────────────────────
ENVIRONMENT=dev
# Accept testnet address formats (testnet runs only)
TESTNET_MODE=false
LOG_LEVEL=INFO
LOG_JSON=true

# ── Telegram ─────────────────────────────────────────────────────────────────
BOT_TOKEN=
BOT_USERNAME=escrow_guarantee_bot
WEBHOOK_BASE_URL=https://bot.example.com
# Random string; Telegram sends it back in X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=
# Bootstrap admins (Telegram user ids), comma-separated
ADMIN_IDS=

# ── Infrastructure ───────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://escrow:escrow@postgres:5432/escrow
REDIS_URL=redis://redis:6379/0
CHAINS_CONFIG_PATH=chains.yaml

# ── Crypto Pay (CryptoBot) ───────────────────────────────────────────────────
# Testnet: @CryptoTestnetBot → Crypto Pay → Create App. Enable "Transfers" in the app settings.
CRYPTOBOT_API_TOKEN=
CRYPTOBOT_TESTNET=true
# Random path segment for the webhook URL: /cryptopay/<secret>
CRYPTOBOT_WEBHOOK_SECRET_PATH=

# ── Fees and limits (USDT) ───────────────────────────────────────────────────
FEE_RATE_BPS=200
FEE_MIN_USDT=1.00
DEAL_MIN_USDT=5
DEAL_MAX_USDT=10000
NEW_USER_DEAL_MAX_USDT=300
NEW_USER_COMPLETED_DEALS=3
# seller | service — who bears the fixed payout network fee
NETWORK_FEE_PAYER=seller
# discount | surcharge — unique-amount tag lowers or raises the amount to pay
TAG_MODE=discount
OVERPAY_DUST_USDT=1.00
REFUND_CHARGES_SERVICE_FEE=false
DISPUTE_KEEPS_FEE_DEFAULT=true

# ── Timeouts (ISO 8601 durations or seconds) ─────────────────────────────────
OFFER_TTL=PT24H
PAY_START_TTL=PT24H
PAYMENT_TTL=PT30M
PAYMENT_EXTENSION=PT30M
BUYER_REMINDER_INTERVAL=PT24H
BUYER_SILENCE_DISPUTE_AFTER=PT72H
REFUND_OBJECTION_WINDOW=PT12H
TAG_COOLDOWN=PT72H
DISPUTE_SLA=PT24H

# ── Reconciliation and stuck-work checks (worker) ────────────────────────────
RECONCILE_INTERVAL=PT15M
# A balance mismatch alerts only if it was already there this long ago (filters in-flight payments).
RECONCILE_CONFIRM_AFTER=PT5M
# Unexplained missing money stops payouts from that wallet until an admin resumes them (TOTP).
RECONCILE_AUTO_PAUSE=true
WORKER_LAG_ALERT=PT10M
STUCK_PAYOUT_AFTER=PT1H
PAYOUT_APPROVAL_SLA=PT4H
UNIDENTIFIED_SLA=PT24H
REFUND_ADDRESS_REMINDER_INTERVAL=PT24H

# ── Payout controls ──────────────────────────────────────────────────────────
# Payouts at or above the threshold wait for one admin confirmation.
MANUAL_APPROVAL_THRESHOLD_USDT=2000
LARGE_PAYOUT_APPROVALS=1
# Disputes are decided by a single admin; the decision authorizes the resulting payouts.
DISPUTE_PAYOUT_REQUIRES_APPROVAL=false
HOT_WALLET_LIMIT_USDT=10000

# ── On-chain signer ──────────────────────────────────────────────────────────
# Keystore v3 files of the hot wallets (create with: python -m app.cli keystore-import <file>).
SIGNER_KEYSTORE_DIR=
SIGNER_PASSWORD=
SIGNER_MAX_PAYOUT_USDT=5000
SIGNER_DAILY_LIMIT_USDT=20000
TRON_FEE_LIMIT_TRX=30

# ── Admin security ───────────────────────────────────────────────────────────
# Money actions of admins (dispute decisions, payout approvals, unidentified payments) need a TOTP code.
ADMIN_TOTP_REQUIRED=true
# Fernet key for TOTP secrets at rest:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_ENCRYPTION_KEY=

# ── Chain data providers (free tiers) ────────────────────────────────────────
TRONGRID_API_KEY=
TONCENTER_API_KEY=
TONAPI_KEY=
